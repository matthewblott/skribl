<% content_for :title, 'Scribbles' %>

<%= turbo_frame_tag "notes_user_#{Current.user.id}" do %>
  <% @notes.each do |note| %>
    <%= render "note", note: note %>
  <% end %>
<% end %>

<%= turbo_frame_tag :frame_identifier, 
  loading: :lazy,
  src: user_notes_path(Current.user, format: :turbo_stream, page: @pagy.next)
%>
