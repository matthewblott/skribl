<% content_for :title, "Sign in" %>

<% content_for :header_controls do %>
  <div role="group">
    <a href="<%= auth_path %>" role="button">Start again</a>
  </div>
<% end %>

<p>Enter your email address and we’ll send you a code to sign in.</p>

<form action="<%= auth_send_code_path %>" method="post">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <input type="email" name="email" placeholder="alice@example.com" required>
  <button data-controller="bridge--button" class="hotwire-native-hidden">Send Code</button>
</form>

<div
  data-controller="immediate-toast"
  data-bridge-message="One two buckle shoe"
></div>
