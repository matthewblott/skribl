<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Skribl" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Skribl">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-cache-control" content="no-cache">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= vite_client_tag %>
    <%= vite_stylesheet_tag 'index' %>
    <%= vite_javascript_tag 'index' %>
  </head>

  <body
    <%= "data-controller=\"#{content_for(:page_controller)}\"".html_safe if content_for?(:page_controller) %>
    class="<%= 'hotwire-native' if is_native_app? %>"
  >
    <header class="hotwire-native-hidden">
      <%= render 'shared/header' %>
    </header>
    <div id="alerts" class="hotwire-native-hidden">
      <%= render 'shared/alerts' %>
    </div>
    <% if is_signed_in? %>
      <%= turbo_stream_from AlertsChannel.stream_name_for(Current.user.id) %>
    <% end %>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
