<% content_for :title, 'Information' %>
<style>

  p {
    margin-left: 0.5rem;
    margin-right: 0.5rem;
    font-size: 1.2rem;
  }

</style>

<p style="margin-top: 1rem">
Your notes are stored securely for this device only.
</p>
<p>
If you delete the app or clear your data, your notes cannot be recovered.
</p>
<p>
You can export your notes at any time as a ZIP file.
</p>
<p>
By continuing, you agree to our <a href="/terms">Terms and Conditions</a> and <a href="/privacy">Privacy Policy</a>.
</p>

<form action="/sign_in" method="post" id="sign_in_form">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
</form>

<button type="submit" form="sign_in_form" class="pill outline">Continue</button>

