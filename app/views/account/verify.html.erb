<% content_for :title, "Verify Email" %>

<% content_for :header_controls do %>
  <div role="group">
    <a href="<%= user_account_path %>" role="button">Account</a>
  </div>
<% end %>

<p>
  We've sent you a code. Enter it below to finish registering your email address.
</p>

<form action="<%= user_account_verify_code_path %>" accept-charset="utf-8" method="post">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
  <input type="email" name="email" placeholder="alice@example.com" value="<%= @email %>" required>
  <input type="number" name="otp_code" placeholder="123456" required>
  <button data-controller="bridge--button" class="hotwire-native-hidden">Verify Code</button>
</form>
