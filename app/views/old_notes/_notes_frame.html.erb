<%= turbo_frame_tag :pagination do %>
  <% notes.each do |note| %>
    <%= render partial: "notes/note", locals: { note: note } %>
  <% end %>

  <% if pagy.next %>
    <%= turbo_frame_tag :pagination, 
        src: user_notes_path(page: pagy.next),
        loading: "lazy" do %>
      Loading more...
    <% end %>
  <% end %>
<% end %>
