<%= turbo_stream.append "user_#{Current.user.id}_notes_element" do %>
  <% @notes.each do |note| %>
    <%= render partial: "notes/note", locals: { note: note } %>
  <% end %>
<% end %>

<%= turbo_stream.replace :frame_identifier do %>
  <% if @pagy.next.present? %>
    <%= turbo_frame_tag :frame_identifier, 
      loading: :lazy,
      src: user_notes_path(Current.user, format: :turbo_stream, page: @pagy.next)
    %>
  <% end %>
<% end %>
