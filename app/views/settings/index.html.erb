<% content_for :title, 'Settings' %>

<controls role="group" class="hotwire-native-hidden">
  <%= link_to :New, user_notes_new_path(Current.user, Note.new), role: "button" %>
  <%= link_to "Notes", user_notes_path(Current.user), role: "button" %>
</controls>

<div class="settings">

  <%= form_with url: sessions_path,
    method: :delete,
    class: "hidden",
    html: {
      id: "sign_out_form",
    } do %>
  <%  end %>

    <%#= button_tag "Sign out", 
      data: {
        turbo: false,
      },
      form: "sign_out_form",
      class: "outline hotwire-native-hidden pill"
    %>

  <hr class="hotwire-native-hidden">

  <h2>Delete Session</h2>
  <p>
  This action is not reversible. All information related to this session will be deleted permanently.
  </p>

  <%= button_to "Delete my session",
    # settings_path, 
    sessions_path, 
    method: :delete,
    data: {
      controller: "bridge--delete-account",
      turbo_frame: "_top",
      action: "click->bridge--delete-account#submit",
      # turbo_method: :delete,
      # turbo_confirm: "Are you sure?",
      bridge_title: "Delete Session",
      bridge_confirm: "Confirm",
      bridge_dismiss: "Cancel",
      bridge_description: "Are you sure you want to delete your session?"
    },
    class: "danger outline pill"
  %>

  <h2>Download Notes</h2>
  <p>
  Download your notes as a zip file.
  </p>

  <%= form_with url: download_images_path,
    class: "hidden",
    data: {
      turbo: false,
    },
    html: {
      id: "download_form",
      formtarget: "_top"
    } do %>
  <% end %>

  <button
    data-controller="bridge--download"
    data-action="bridge--download#submit"
    data-token="<%= form_authenticity_token %>"
    form="<%= unless native_app? then "download_form" end %>"
    type="submit"
    class="outline pill"
  >Download
  </button>

</div>
