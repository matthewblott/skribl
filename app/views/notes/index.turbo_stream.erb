<%= turbo_stream.append "notes_element" do %>
  <%= render @notes %>
<% end %>

<%= turbo_stream.replace :frame_identifier do %>
  <% if @pagy.next.present? %>
    <%= turbo_frame_tag :frame_identifier, 
      loading: :lazy,
      src: user_notes_path(format: :turbo_stream, page: @pagy.next)
    %>
  <% end %>
<% end %>
