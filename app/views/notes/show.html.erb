<div class="bg-white shadow rounded-lg p-6">
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold"><%= @note.title %></h1>
    <div class="space-x-2">
      <%= link_to "Edit", edit_user_note_path(Current.user, @note), 
          class: "bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" %>
      <%= link_to "Back", user_notes_path(Current.user), 
          class: "bg-gray-500 hover:bg-gray-700 text-white font-bold py-2 px-4 rounded" %>
    </div>
  </div>

  <div class="prose max-w-none">
    <%= simple_format(@note.content) %>
  </div>

  <div class="mt-6 border-t pt-4">
    <%= link_to "Delete Note", user_note_path(Current.user, @note), 
        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this note?" },
        class: "text-red-500 hover:text-red-700" %>
  </div>
</div>
