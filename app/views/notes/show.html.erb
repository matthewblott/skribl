<% content_for :title, 'Scribble' %>

<%#= link_to "Delete", user_note_path(Current.user, @note), method: :delete %>
<%#= link_to "Link Only", user_notes_path(Current.user, @note) %>

<%= button_to "Delete",
  user_note_path(Current.user, @note),
  turbo: false,
  method: :delete,
  data: {
    controller: "bridge--delete-note",
    # turbo_frame: "_top",
    turbo_method: :delete,
    # turbo_confirm: "Are you sure?",
    bridge_title: "Delete",
    bridge_confirm: "Confirm",
    bridge_dismiss: "Cancel",
    bridge_description: "Are you sure you want to delete this note?"
  },
  class: "hotwire-native-hidden"
%>

<div>

  <%= image_tag "/uploads/user_#{Current.user.id}/#{@note.id}.png",
    alt: @note.content,
    title: @note.content
  %> 

</div>
