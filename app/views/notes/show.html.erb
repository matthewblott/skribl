<h1>note</h1>

<% turbo_page_requires_reload %>

<%= turbo_stream_from @note %>

<controls>
  <%= link_to :Edit, edit_user_note_path(Current.user) %>
  <%= link_to :Back, user_notes_path(Current.user) %>
  <%= button_to "Delete",
    user_note_path(Current.user, @note),
    method: :delete, # Remove to use turbo 
    data: {
      turbo: false,
      turbo_method: :delete, # Only used with turbo
      turbo_confirm: "Are you sure?" # Only used with turbo
    }
  %>

</controls>

<%= render "form", disabled: true %>
