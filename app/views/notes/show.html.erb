<div>
  <div>
    <h1><%= @note.title %></h1>
    <div>
      <%= link_to "Edit", edit_user_note_path(Current.user, @note) %>
      <%= link_to "Back", user_notes_path(Current.user) %>
    </div>
  </div>

  <div>
    <%= simple_format(@note.content) %>
  </div>

  <div>
    <%= link_to "Delete Note", user_note_path(Current.user, @note), 
        data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this note?" } %>
  </div>
</div>
