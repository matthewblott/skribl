<% content_for :title, 'Scribble' %>

<% turbo_page_requires_reload %>

<%= turbo_stream_from @note %>

<controls role="group" class="hotwire-native-hidden">

  <%= button_tag type: :submit,
    form: "delete_note_#{@note.id}",
    data: {
      controller: "bridge--delete-note",
      # confirm: "Delete this post?",
      turbo: false,
      bridge_title: "Delete",
      bridge_confirm: "Confirm",
      bridge_dismiss: "Cancel",
      bridge_description: "Are you sure you want to delete this note?"
    },
    class: "hotwire-native-hidden" do %>
    Delete
  <% end %>
  <%= link_to "Back",
    user_notes_path,
    data: {
      # controller: "bridge--cancel-delete"
    },
    role: "button" %>
</controls>

<div>
  <%= image_tag "/uploads/#{Current.user.id}/#{@note.id}.png",
    alt: @note.content,
    title: @note.content
  %> 
</div>

<%= form_with url: user_note_path(Current.user, @note),
  method: :delete,
  id: "delete_note_#{@note.id}",
  html: { style: "display:none;" } do %>
<% end %>
