<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">New Note</h1>

  <%= turbo_frame_tag "note_form" do %>
    <%= render "form", note: @note %>
  <% end %>

  <div class="mt-4">
    <%= link_to "Back to notes", user_notes_path(Current.user), class: "text-blue-500 hover:text-blue-700" %>
  </div>
</div>
