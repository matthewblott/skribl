<% content_for :title, "New Note" %>

<style>

  div[data-controller="note"] {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
  }
  canvas {
    flex-grow: 1;
    background-color: lightyellow;
  }
  .hidden {
    display: none;
  }
</style>

<% content_for :header_controls do %>
<% end %>

<div data-controller="note">

  <div role="group">
    <button
      data-controller="bridge--clear-canvas"
      data-note-target="clear"
      data-action="
        click-&gt;note#clear
        note:update@window-&gt;bridge--clear-canvas#update
      "
      disabled
    >Clear</button>
    <button
      data-controller="bridge--create-note"
      data-note-target="save"
      data-action="
        click->note#create
        note:update@window->bridge--create-note#update
      "
      disabled
    >Save</button>
    <a role="button" href="<%= user_notes_path %>">Notes</a>
  </div>
  <canvas data-note-target="canvas"></canvas>

  <turbo-frame id="note_frame">

    <form id="note_form" data-turbo="true" action="<%= user_notes_path %>" method="post">

      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
      <input data-note-target="img" type="hidden" name="note[img]" id="note_img">

      <input type="hidden" name="note[image_saved]" value="0">
      <input type="hidden" name="note[content]" value="0">

      <button
        class="hidden"
        data-note-target="submit"
        data-search-field-target="submit"
        data-disable-with="Create Note"
      >
        Create
      </button>
      
    </form>

  </turbo-frame>
</div>
