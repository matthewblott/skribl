<%= form_with(model: [Current.user, note], data: { turbo: false }) do |form| %>
  <% if note.errors.any? %>
    <div>
      <h3>
        <%= pluralize(note.errors.count, "error") %> prohibited this note from being saved:
      </h3>
      <ul>
        <% note.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :title, value: '' %>

  <div>
    <div>
      <%= form.text_area :content, rows: 10 %>
    </div>
  </div>

  <div>
    <%= form.submit %>
    <%= link_to "Cancel", user_notes_path(Current.user) %>
  </div>
<% end %>

<% if note.persisted? %>
  <%= link_to "Delete Note", user_note_path(Current.user, note), 
      data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this note?" } %>
<% end %>

