<%= turbo_stream_from :notes_after_create_stream, signed: true %>

<controls>
  <%= link_to :New, new_user_note_path(Current.user, @note) %>
</controls>

<hr>

<section id="notes_user_<%= CurrentNoteContext.user_id %>_element">
  <% @notes.each do |note| %>
    <%= render partial: "notes/note", locals: { note: note } %>
  <% end %>

  <% if @pagy.next %>
    <%= turbo_frame_tag :pagination, 
        src: user_notes_path(Current.user, page: @pagy.next),
        loading: "lazy" do %>
      Loading more...
    <% end %>
  <% end %>
</section>
