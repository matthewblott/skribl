<% content_for :title, 'Scribbles' %>

<%= turbo_stream_from :user_notes_stream, signed: true %>


<controls role="group" class="hotwire-native-hidden">
  <%= link_to :New, new_user_note_path(Current.user, @note), role: "button" %>
  <%= link_to :Settings, settings_path, role: "button" %>

  <%= button_tag "Select all",
    data: {
      # controller: "bridge--toggle-note-selection"
      controller: "ui--toggle-selection",
      action: "ui--toggle-selection#toggle"
    },
    class: "hotwire-native-hidden"
  %>

  <%= button_tag "Delete",
    data: {
      controller: "ui--delete-button",
      action: "
        ui--delete-button#submit
        ui--delete-form:updated@window->ui--delete-button#update
        ui--items:updated@window->ui--delete-button#update
      "
    },
    disabled: true,
    form: "delete-form"
  %>
</controls>

<%= form_with url: user_notes_path(Current.user),
  method: :delete,
  data: {
    controller: 'ui--delete-form',
    action: "
      ui--delete-button:submit@window->ui--delete-form#submit
      ui--items:updated@window->ui--delete-form#update
    "
  },
  id: "delete-form" do |f| %>
<% end %>

<section id="user_<%= Current.user.id %>_notes">
  <div
    data-controller="ui--items"
    data-action="
      ui--items#toggle
      ui--toggle-selection:toggle@window->ui--items#toggle
    "
  >
  <% @notes.each do |note| %>
    <%= render partial: "notes/note", locals: { note: note } %>
  <% end %>

  <% if @pagy.next %>
    <%= turbo_frame_tag :pagination, 
        src: user_notes_path(Current.user, page: @pagy.next),
        loading: "lazy" do %>
      Loading more...
    <% end %>
  <% end %>
</section>
