<% content_for :title, 'Scribbles' %>

<%= turbo_stream_from :user_notes_stream, signed: true %>

<controls role="group" class="hotwire-native-hidden">
  <%= link_to :New, new_user_note_path(Current.user, @note), role: "button" %>
  <%= link_to :Settings, settings_path, role: "button" %>
  <%= button_tag "Select all",
    data: {
      controller: "
        ui--toggle-selection
        bridge--toggle-note-selection
      ",
    action: "
      ui--toggle-selection#toggle
      ui--items:update@window->ui--toggle-selection#update
    "
    },
    class: "hotwire-native-hidden"
  %>

  <%= button_tag "Delete",
    data: {
      controller: "
        ui--delete-button
        bridge--delete-note
      ",
      action: "
        ui--delete-button#submit
        ui--items:update@window->bridge--delete-note#update
        ui--items:update@window->ui--delete-button#update
      "
    },
    disabled: true,
    form: "delete-form"
  %>
</controls>

<%= form_with url: user_notes_path(Current.user),
  method: :delete,
  data: {
    controller: "
      ui--delete-form
    ",
    action: "
      bridge--delete-note:submit@window->ui--delete-form#submit
      ui--delete-button:submit@window->ui--delete-form#submit
      ui--items:update@window->ui--delete-form#update
    "
  },
  id: "delete-form" %>

<section id="user_<%= Current.user.id %>_notes"
  data-controller="ui--items"
  data-action="
    ui--items#toggle
    ui--toggle-selection:toggle@window->ui--items#toggle
    turbo:render->ui--items#update
  "
>
  <% @notes.each do |note| %>
    <%= render partial: "notes/note", locals: { note: note } %>
  <% end %>

  <% if @pagy.next %>
    <%= turbo_frame_tag :pagination, 
        src: user_notes_path(Current.user, page: @pagy.next),
        loading: "lazy" do %>
      Loading more...
    <% end %>
  <% end %>
</section>
