<div class="space-y-6">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">My Notes</h1>
    <%= link_to "New Note", new_user_note_path(Current.user), 
        class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded",
        data: { turbo_frame: "_top" } %>
  </div>

  <%= turbo_frame_tag "notes" do %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @notes.each do |note| %>
        <%= turbo_frame_tag dom_id(note) do %>
          <div class="bg-white shadow rounded-lg p-6">
            <h2 class="text-xl font-semibold mb-2"><%= note.title %></h2>
            <p class="text-gray-600 mb-4"><%= truncate(note.content, length: 100) %></p>
            <div class="flex justify-end space-x-2">
              <%= link_to "View", user_note_path(Current.user, note), 
                  class: "text-blue-500 hover:text-blue-700",
                  data: { turbo_frame: "_top" } %>
              <%= link_to "Edit", edit_user_note_path(Current.user, note), 
                  class: "text-green-500 hover:text-green-700",
                  data: { turbo_frame: "_top" } %>
              <%= link_to "Delete", user_note_path(Current.user, note), 
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                  class: "text-red-500 hover:text-red-700" %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
