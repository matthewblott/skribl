<% content_for :title, 'Scribbles' %>

<controls>
  <%= link_to "First", user_notes_path(Current.user) + "?page=1", role: "button", class: "hotwire-native-hidden" %>
  <% if @pagy.page > 1 %>
    <%= link_to "Previous", user_notes_path(Current.user) + "?page=" + (@pagy.page - 1).to_s, role: "button", class: "hotwire-native-hidden"  %>
  <% else %>
    <a href="#" role="button" class="hotwire-native-hidden">Previous</a>
  <% end %>
  <% if @pagy.page == @pagy.last %>
    <a href="#" role="button" class="hotwire-native-hidden">Next</a>
  <% else %>
    <%= link_to "Next", user_notes_path(Current.user) + "?page=" + (@pagy.page.next).to_s, role: "button", class: "hotwire-native-hidden" %>
  <% end %>

  <%= link_to "Last", user_notes_path(Current.user) + "?page=" + (@pagy.last).to_s, role: "button", class: "hotwire-native-hidden" %>

  <%= link_to "New Scribble", new_user_note_path(Current.user), 
    data: {
      turbo_frame: "_top",
      controller: "bridge--new-note"
    },
    role: "button",
    class: "hotwire-native-hidden" %>
</controls>

<%= turbo_stream_from "notes" %>

<div id="notes_list">
  <%= render @notes %>
</div>
