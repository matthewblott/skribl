<p style="color: green"><%= notice %></p>

<style>
  article {
    a {
      width: 100%;
      display: flex;
      justify-content: space-between;
      padding: 0 2rem;
      align-items: center;

      div {
        display: flex;
        flex-direction: column;
        h2 {
          color: color-mix(in srgb, var(--color-primary), black 30%);
          font-size: xx-large;
        }
        h3 {
          font-size: large;
          color: grey;
        }
      }
    }
  }
  p {
    margin-left: 0.5rem;
    margin-right: 0.5rem;
    font-size: 1.2rem;
    text-align: center;
  }

</style>

<% content_for :title, "Notes" %>

<% content_for :header_controls do %>
  <div role="group">
    <a href="<%= user_home_path %>" role="button">Home</a>
    <a href="<%= user_new_note_path %>" role="button">New</a>
  </div>
<% end %>

<% if @notes.empty? %>
  <p>
    You haven't created any notes yet.
  </p>
<% end %>

<%= turbo_stream_from :notes_after_create_stream %>

<section id="notes_element">
  <% @notes.each do |note| %>
    <%= render partial: "notes/note", locals: { note: note } %>
  <% end %>

  <% if @pagy.next %>
    <turbo-frame id="pagination" src="<%= user_notes_path(page: @pagy.next) %>" loading="lazy">
      Loading more...
    </turbo-frame>
  <% end %>
</section>
