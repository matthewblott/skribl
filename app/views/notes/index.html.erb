<% content_for :title, "Notes" %>

<style>
  .selected {
    background-color: lightyellow;
  }
  [id^="note_"] {
    cursor: pointer;  
    cursor: default;  
  }
</style>

<% content_for :page_controller, "notes" %>

<% content_for :header_controls do %>
  <div role="group">
    <a href="<%= user_home_path %>" role="button">Home</a>
    <a href="<%= user_new_note_path %>" role="button">New</a>
    <button data-notes-target="selectAllButton"
            data-action="notes#toggleAll">Select all</button>
    <button data-notes-target="deleteButton"
            data-action="notes#submitDelete" disabled>Delete</button>
  </div>
<% end %>

<form id="delete-form" action="<%= user_notes_destroy_multiple_path %>" method="post"
      data-notes-target="form">
  <input type="hidden" name="_method" value="delete">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
</form>

<% @notes.each do |note| %>
  <% note.user_id = Current.user.id %>
  <%= render partial: "notes/note", locals: { note: note } %>
<% end %>

<% if @pagy.next %>

  <turbo-frame id="pagination" src="<%= user_notes_path(page: @pagy.next) %>" loading="lazy">
    Loading more...
  </turbo-frame>

<% end %>
