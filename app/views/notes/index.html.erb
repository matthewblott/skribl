<div>
  <div>
    <h1>My Notes</h1>
    <%= link_to "New Note", new_user_note_path(Current.user), 
        data: { turbo_frame: "_top" } %>
  </div>


  <%= link_to "First", user_notes_path(Current.user) + "?page=1", role: "button" %>
  <% if @pagy.page > 1 %>
    <%= link_to "Previous", user_notes_path(Current.user) + "?page=" + (@pagy.page - 1).to_s, role: "button"  %>
  <% else %>
    <a href="#" role="button">Previous</a>
  <% end %>
  <% if @pagy.page == @pagy.last %>
    <a href="#" role="button">Next</a>
  <% else %>
    <%= link_to "Next", user_notes_path(Current.user) + "?page=" + (@pagy.page.next).to_s, role: "button" %>
  <% end %>
  <%= link_to "Last", user_notes_path(Current.user) + "?page=" + (@pagy.last).to_s, role: "button" %>

  <%= turbo_frame_tag "notes" do %>
    <div>
      <% @notes.each do |note| %>
        <%= turbo_frame_tag dom_id(note) do %>
          <div>
            <p><%= truncate(note.content, length: 100) %></p>
            <div>
              <%= link_to "Edit", edit_user_note_path(Current.user, note), 
                  data: { turbo_frame: "_top" } %>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @pagy.next %>
        <%= turbo_frame_tag "posts", loading: :lazy, src: user_notes_path(@notes, page: @pagy.next) do %>
          <!--- put your loading prompt and/or spinner here --->
        <% end %>
      <% end %>

    </div>
  <% end %>
</div>
