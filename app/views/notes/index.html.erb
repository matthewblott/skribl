<p style="color: green"><%= notice %></p>

<% content_for :title, "Notes" %>

<div id="notes">
  <% @notes.each do |note| %>
    <%= render note %>
    <p>
      <%= link_to "Show this Note",  user_note_path(Current.user, note) %>
    </p>
  <% end %>
</div>

<%= link_to "New Note", user_new_note_path %>
