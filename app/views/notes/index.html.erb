<h1 class="text-2xl font-bold mb-6">My Notes</h1>

<div class="mb-4">
  <%= link_to "New Note", new_note_path, class: "bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded" %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  <% @notes.each do |note| %>
    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-xl font-semibold mb-2"><%= note.title %></h2>
      <p class="text-gray-600 mb-4"><%= truncate(note.content, length: 100) %></p>
      <div class="flex justify-end space-x-2">
        <%= link_to "View", note_path(note), class: "text-blue-500 hover:text-blue-700" %>
        <%= link_to "Edit", edit_note_path(note), class: "text-green-500 hover:text-green-700" %>
        <%= link_to "Delete", note_path(note), 
            data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
            class: "text-red-500 hover:text-red-700" %>
      </div>
    </div>
  <% end %>
</div>
