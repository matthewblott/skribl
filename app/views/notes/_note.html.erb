<div id="<%= dom_id note %>" data-action="click->ui--items#select">
  <% if note.image_saved %>
    <%#= image_tag "/#{note.user_id}/uploads/#{note.id}.png" %> 
  <% else %>
    <%#= note.created_at.strftime("%Y-%m-%d %H:%M:%S") %>
  <% end %>

  <%= note.created_at.strftime("%Y-%m-%d %H:%M:%S") %>

</div>
