<% content_for :title, @note.title %>

<% content_for :header_controls do %>
  <div role="group">
    <a href="<%= user_notes_path %>" role="button">Notes</a>
    <button form="note_form" formaction="<%= user_note_destroy_path %>" name="_method" value="delete">Delete</button>
    <button form="note_form" formaction="<%= user_note_update_path %>" name="_method" value="patch">Save</button>
  </div>
<% end %>

<%= render "form", note: @note %>

