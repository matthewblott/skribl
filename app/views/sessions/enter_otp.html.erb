<% content_for :title, 'Enter Code' %>

<%= button_tag "Placeholder",
  data: {
    controller: 'bridge--ios-placeholder'
  },
  class: 'hotwire-native-hidden hidden' %>


<%= form_with(url: sign_in_path, html: { onkeydown: "return event.key !== 'Enter';" }) do |f| %>
  <div>
    <%= f.label :email, class: 'hidden' %>
    <%= f.email_field :email, value: @email, class: 'pill hidden' %>
  </div>
  <div>
    <p>
    Enter the code we sent to <strong><%= @email %></strong> and press Submit to sign in.
    </p>
    <%= f.label :otp_code, "One-Time Code", class: 'hidden' %>
    <%= f.text_field :otp_code,
      placeholder: "123456",
      class: 'pill',
      autocomplete: 'off',
      required: true
     %>
  </div>

  <%= f.submit "Submit",
    data: {
      controller: "bridge--sign-in"
    },
    class: 'hotwire-native-hidden pill' %>

<% end %>

<p>
  If the code hasn't appeared in your inbox check your spam or <%= link_to "press here", send_otp_path(email: @email) %> and try again.
</p>


