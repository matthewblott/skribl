<% content_for :title, 'Sign in' %>

<%= form_with(url: sign_in_path, html: { onkeydown: "return event.key !== 'Enter';" }) do |form| %>
  <%= form.label :email %>
  <%= form.email_field :email, 
      value: params[:email_hint], 
      required: true, 
      autofocus: true, 
      autocomplete: "email" %>

  <%= form.label :password %>

  <%= form.password_field :password, 
      required: true, 
      value: 'password12345',
      autocomplete: "current-password" %>

  <%= form.submit "Submit", data: {
    controller: "bridge--sign-in"
  }, class: 'hotwire-native-hidden' %>

<% end %>
