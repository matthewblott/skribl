<h1>Sign in</h1>

<% if notice %>
  <div>
    <p><%= notice %></p>
  </div>
<% end %>

<% if alert %>
  <div>
    <p><%= alert %></p>
  </div>
<% end %>

<%= form_with(url: sign_in_path) do |form| %>
  <div>
    <%= form.label :email %>
    <div>
      <%= form.email_field :email, 
          value: params[:email_hint], 
          required: true, 
          autofocus: true, 
          autocomplete: "email" %>
    </div>
  </div>

  <div>
    <%= form.label :password %>
    <div>
      <%= form.password_field :password, 
          required: true, 
          autocomplete: "current-password" %>
    </div>
  </div>

  <div>
    <%= form.submit "Sign in" %>
  </div>
<% end %>

<div>
  <hr>
  <p>Or</p>
  <div>
    <%= link_to "Sign up", sign_up_path %>
    <%= link_to "Forgot your password?", new_identity_password_reset_path %>
  </div>
</div>
