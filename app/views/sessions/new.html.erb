<% content_for :title, 'Sign in' %>

<% if notice %>
  <div>
    <p><%= notice %></p>
  </div>
<% end %>

<% if alert %>
  <div>
    <p><%= alert %></p>
  </div>
<% end %>

<%= form_with(url: sign_in_path, html: { onkeydown: "return event.key !== 'Enter';" }) do |form| %>
  <%= form.label :email %>
  <%= form.email_field :email, 
      value: params[:email_hint], 
      required: true, 
      autofocus: true, 
      autocomplete: "email" %>

  <%= form.label :password %>

  <%= form.password_field :password, 
      required: true, 
      value: 'password12345',
      autocomplete: "current-password" %>

  <%= form.submit "Submit", data: {
    controller: "bridge--sign-in"
  }, class: 'hotwire-native-hidden' %>


  <%= link_to "Status", status_path, 
    data: {
      turbo_frame: "_top",
      controller: "bridge--status"
    },
    role: "button",
    class: "hotwire-native-hidden" %>

<% end %>

<sign-up>
  Don't have an account? <%= link_to "Sign up", sign_up_path %>
</sign-up>

