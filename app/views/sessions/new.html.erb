<div class="sign-in-page">
  <div class="sign-in-container">
    <h2>Sign in to your account</h2>
  </div>

  <div class="sign-in-form-container">
    <div class="sign-in-form-wrapper">
      <% if notice %>
        <div class="notice-message success">
          <div class="message-content">
            <div class="message-icon">
              ✓
            </div>
            <div class="message-text">
              <p><%= notice %></p>
            </div>
          </div>
        </div>
      <% end %>

      <% if alert %>
        <div class="notice-message error">
          <div class="message-content">
            <div class="message-icon">
              ⚠
            </div>
            <div class="message-text">
              <p><%= alert %></p>
            </div>
          </div>
        </div>
      <% end %>

      <%= form_with(url: sign_in_path, class: "sign-in-form") do |form| %>
        <div class="form-group">
          <%= form.label :email %>
          <div class="input-field">
            <%= form.email_field :email, 
                value: params[:email_hint], 
                required: true, 
                autofocus: true, 
                autocomplete: "email",
                class: "text-input" %>
          </div>
        </div>

        <div class="form-group">
          <%= form.label :password %>
          <div class="input-field">
            <%= form.password_field :password, 
                required: true, 
                autocomplete: "current-password",
                class: "text-input" %>
          </div>
        </div>

        <div class="form-actions">
          <%= form.submit "Sign in", class: "submit-button" %>
        </div>
      <% end %>

      <div class="form-footer">
        <div class="divider">
          <span>Or</span>
        </div>

        <div class="alternative-actions">
          <div>
            <%= link_to "Sign up", sign_up_path, class: "secondary-button" %>
          </div>
          <div>
            <%= link_to "Forgot your password?", new_identity_password_reset_path, class: "secondary-button" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
