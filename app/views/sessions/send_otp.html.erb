<% content_for :title, 'Send Code' %>

<style>

input, p {
  font-size: 1.1rem;
}

  /* Remove the default blue outline/border */
  input[type="email"]:focus {
    outline: none;            /* removes the outline */
    box-shadow: none;         /* Chrome/Edge adds a shadow */
    border-color: transparent;/* optional – hide the border color */
  }

  /* Optional: replace it with a custom, accessible style */
  input[type="email"]:focus-visible {
  }

  input.is-valid {

    border-color: green !important;
  }
  
  input.is-invalid {
    border-color: red !important;
  }

  p  {
    margin-left: 0.5rem;
    margin-right: 0.5rem;
  }

</style>

<%#= button_tag "Placeholder",
  data: {
    controller: 'bridge--ios-placeholder',
    action: 'click->note#clear'
  },
  class: 'hotwire-native-hidden hidden' %>

<p style="margin-top: 1rem">
  Enter your email address and press Submit to receive a code for signing in.
</p>

<%= form_with(url: validate_otp_path, html: { onkeydown: "return event.key !== 'Enter';" }) do |f| %>
  <div>
    <%= f.label :email, class: 'hidden' %>
    <%= f.email_field :email,
      data: {
        controller: "ui--email",
        action: "
          input->ui--email#check
          change->ui--email#check
          invalid->ui--email#showInvalid
        "
      },
      value: @email,
      placeholder: "hello@example.com",
      class: 'pill',
      autocomplete: 'off',
      required: true
    %>
    <div data-email-target="error" class="error-msg"></div>
  </div>

  <%= f.submit "Submit",
    data: {
      controller: "
        ui--send-otp
        bridge--send-otp
        ui--email:update@window->ui--send-otp#update
      ",
      action: "ui--email:update@window->ui--send-otp#update"
    },
    class: 'hotwire-native-hidden pill'
  %>
<% end %>
<p>
<%# Your email is used to create your account, securely sync your logs, and recover access. We do not send marketing emails. %>

We use your email address only to create and secure your account, sync your logs, and recover access if needed.


</p>
<p>

We do not send marketing emails.

</p>

<p>

This application's <strong>Privacy Policy</strong> can be found <a href="/privacy">here</a>.

</p>

<p>

This application's <strong>Terms and Conditions</strong> can be found <a href="/terms">here</a>.

</p>

